// Android `ui/settings/HomePage.kt`, desktop Services: Microphone, Global Shortcut, and on Wayland Text Input.

import { Icons } from "../theme.slint";
import { Services } from "../globals.slint";
import { Card, ServicesDivider } from "../components/basics.slint";
import { NavCard, StatusRow } from "../components/rows.slint";
import { PageScaffold } from "../components/page.slint";
import { LostTranscriptCard } from "../components/lost_transcript.slint";

export component HomePage inherits PageScaffold {
    callback open(page: int);

    Card {
        vertical-padding: 14px;
        StatusRow {
            icon: Icons.mic;
            icon-size: 20px;
            icon-top-padding: 2px;
            title: "Microphone";
            ok: Services.microphone-found;
            ok-text: "Found";
            not-ok-text: "Not found";
            helper: "Connect a microphone, or check that Iris may use it.";
            setup => { Services.microphone-setup(); }
        }
        ServicesDivider { }
        StatusRow {
            icon: Icons.keyboard;
            icon-size: 20px;
            icon-top-padding: 2px;
            title: "Global Shortcut";
            ok: Services.shortcut-registered;
            ok-text: "Registered";
            not-ok-text: "Not registered";
            helper: Services.shortcut-helper;
            setup => { Services.shortcut-setup(); }
        }
        if Services.wayland: ServicesDivider { }
        if Services.wayland: StatusRow {
            icon: Icons.clipboard-paste;
            icon-size: 20px;
            icon-top-padding: 2px;
            title: "Text Input";
            ok: Services.text-input-ready;
            ok-text: "Ready";
            not-ok-text: "Missing";
            helper: Services.text-input-helper;
            setup => { Services.text-input-setup(); }
        }
    }
    if Services.lost-transcript != "": LostTranscriptCard { }
    NavCard {
        icon: Icons.audio-lines;
        icon-size: 20px;
        title: "Transcription Settings";
        subtitle: "Set up transcription provider settings";
        clicked => { root.open(1); }
    }
    NavCard {
        icon: Icons.sparkles;
        icon-size: 21px;
        title: "Post Processing Settings";
        subtitle: "Set up post processing for the transcribed text";
        clicked => { root.open(2); }
    }
    NavCard {
        icon: Icons.keyboard;
        title: "Dictation Settings";
        subtitle: "Shortcut, text insertion, sounds and startup";
        clicked => { root.open(5); }
    }
    NavCard {
        icon: Icons.eye;
        title: "Appearance";
        subtitle: "Customize Iris to fit you";
        clicked => { root.open(4); }
    }
    NavCard {
        icon: Icons.gauge;
        title: "Statistics";
        subtitle: "Transcription and cleanup times and usage";
        clicked => { root.open(7); }
    }
    NavCard {
        icon: Icons.database-backup;
        title: "Backup and Restore";
        subtitle: "Save or restore settings and API keys";
        clicked => { root.open(8); }
    }
    NavCard {
        icon: Icons.info;
        title: "About Iris";
        subtitle: "Version, licences and credits";
        clicked => { root.open(6); }
    }
}
